rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.uid == "n1tjRh8G6SSr3rSj3mQmV0Mxw8k2"
          || exists(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          )
        );
    }

    match /products/{productId} {
      allow read: if isAdmin() || resource.data.status == "published";
      allow create, update, delete: if isAdmin();
    }

    match /components/{componentId} {
      allow read: if isAdmin() || resource.data.status == "published";
      allow create, update, delete: if isAdmin();
    }

    // Admin documents are created manually by the project owner.
    match /admins/{userId} {
      allow read, write: if false;
    }
  }
}
